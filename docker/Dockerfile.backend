# syntax=docker/dockerfile:1.7
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace

# Copy only Maven metadata first so dependency resolution is cached.
COPY posBackend/pom.xml ./pom.xml
COPY posBackend/.mvn ./.mvn
COPY posBackend/mvnw ./mvnw
RUN chmod +x ./mvnw
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -DskipTests -Dmaven.test.skip=true -Dfrontend.skip=true dependency:go-offline

COPY posBackend/src ./src
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -DskipTests -Dmaven.test.skip=true -Dfrontend.skip=true package

FROM eclipse-temurin:17-jre
WORKDIR /app

RUN groupadd --system app && useradd --system --gid app app

COPY --from=build /workspace/target/*.jar /app/app.jar

EXPOSE 8080
USER app
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
