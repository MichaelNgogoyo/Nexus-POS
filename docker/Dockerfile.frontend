FROM node:24-alpine AS build
WORKDIR /app

ARG VITE_API_BASE_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_REDIRECT_URI

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}
ENV VITE_REDIRECT_URI=${VITE_REDIRECT_URI}

COPY posFrontend/package.json posFrontend/package-lock.json ./
RUN npm ci

COPY posFrontend/. .
RUN npm run build -- --outDir /app/dist --emptyOutDir

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh

ENV VITE_API_BASE_URL=http://localhost:8080
ENV VITE_KEYCLOAK_URL=http://localhost:8081
ENV VITE_KEYCLOAK_REALM=pos
ENV VITE_KEYCLOAK_CLIENT_ID=pos-client
ENV VITE_REDIRECT_URI=http://localhost:3000

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
