FROM golang:1.24.8-alpine3.22@sha256:3d78beb141d98f42337f1252ecf2a5f20374109929a4c3f6817f9e4179cc0ae5 AS builder

ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
RUN apk add --no-cache git ca-certificates && \
    GOTOOLCHAIN=local CGO_ENABLED=0 go install -trimpath "github.com/minio/minio@${MINIO_VERSION}"

FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f

RUN apk add --no-cache ca-certificates su-exec && \
    addgroup -S -g 10001 minio && \
    adduser -S -D -H -u 10001 -G minio minio && \
    mkdir -p /data && chown minio:minio /data

COPY --from=builder /go/bin/minio /usr/local/bin/minio
COPY docker/minio-entrypoint.sh /usr/local/bin/minio-entrypoint
RUN chmod 0755 /usr/local/bin/minio-entrypoint

ENV HOME=/tmp
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio-entrypoint"]
CMD ["server", "/data", "--console-address", ":9001"]
