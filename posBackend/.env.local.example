# Copy to posBackend/.env.local. These values are for local development only.
# Do not reuse them in staging or production.
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=local-postgres-change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-change-me
KEYCLOAK_REALM=pos
KEYCLOAK_CLIENT_ID=pos-client
KEYCLOAK_CLIENT_SECRET=local-dev-public-client
KEYCLOAK_ISSUER_URI=http://keycloak.localhost:8081/realms/pos
KEYCLOAK_REDIRECT_URI=http://localhost:3000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-minio-root-change-me
MINIO_ACCESS_KEY=pos-local-app
MINIO_SECRET_KEY=local-minio-app-change-me
MINIO_BUCKET=product-images

CORS_ALLOWED_ORIGINS=http://localhost:3000
POS_TAX_RATE=0
POS_SERVICE_CHARGE_RATE=0

FRONTEND_PORT=3000
VITE_KEYCLOAK_URL=http://keycloak.localhost:8081
VITE_REDIRECT_URI=http://localhost:3000
