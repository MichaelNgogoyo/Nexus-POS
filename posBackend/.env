#spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

#database
DB_URL=jdbc:postgresql://postgres:5432/pos_db
DB_USERNAME=pos_user
DB_PASSWORD=password

#postgres_container
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=password

#keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/pos
KEYCLOAK_CLIENT_ID=client
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_REDIRECT_URI=http://localhost:5173/login/oauth2/code/pos-client

#minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio123456
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio123456
MINIO_BUCKET=product-images

#CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173, http://localhost:3000, http://localhost:8080, http://localhost:8081, http://localhost:8082, http://localhost:8083, http://localhost:8084, http://localhost:8085, http://localhost:8086, http://localhost:8087, http://localhost:8088, http://localhost:8080